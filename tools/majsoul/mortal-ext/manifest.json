{
  "manifest_version": 3,
  "name": "Mortal一括解析",
  "version": "1.0",
  "description": "牌譜URLの一覧を Mortal（mjai.ekyu.moe）に順番にかけて、解析後URLの一覧を作る",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://mjai.ekyu.moe/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Mortal一括解析" },
  "content_scripts": [
    { "matches": ["https://mjai.ekyu.moe/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
